@dp.message(CommandStart(deep_link=True))
async def cmd_start_deeplink(message: Message, state: FSMContext, command: CommandObject):
    await state.clear()
    user = message.from_user
    args = (command.args or "").strip()

    existing = await db_get_user(user.id)
    if existing is None:
        await db_create_user(user.id, user.username, user.full_name)
    else:
        await db_refresh_profile(user.id, user.username, user.full_name)

    if args == "topup":
        await state.set_state(TopUpFSM.waiting_amount)
        await send_photo_msg(
            message,
            "💰 Введи сумму пополнения в <b>рублях</b> (только число).\n"
            f"Минимум: <b>{CACTUS_MIN_AMOUNT} ₽</b>\n"
            "Например: <code>500</code>",
            kb_back_to_wallet(),
        )
        return

    if args.startswith("ref_"):
        try:
            referrer_id = int(args[4:])
            if referrer_id == user.id:
                referrer_id = None
        except ValueError:
            referrer_id = None

        if referrer_id:
            async with _users_lock:
                def _bind():
                    users = _read_users_sync()
                    if user.id in users and not users[user.id].get("referrer_id"):
                        users[user.id]["referrer_id"] = referrer_id
                        _write_users_sync(users)
                await asyncio.to_thread(_bind)
            try:
                await bot.send_message(
                    referrer_id,
                    "🎉 По твоей ссылке зарегистрировался новый пользователь!",
                )
            except Exception:
                pass

