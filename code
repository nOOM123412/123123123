async def db_stats():
    users = await asyncio.to_thread(_read_users_sync)
    purchases = await asyncio.to_thread(_read_purchases_sync)

    ref_counts = {}
    for u in users.values():
        ref = u.get("referrer_id")
        if ref:
            ref_counts[ref] = ref_counts.get(ref, 0) + 1

    top_sorted = sorted(ref_counts.items(), key=lambda x: x[1], reverse=True)[:5]
    top_refs = []
    for rid, count in top_sorted:
        u = users.get(rid)
        if u:
            top_refs.append({
                "user_id": rid,
                "username": u["username"],
                "full_name": u["full_name"],
                "invited": count,
            })

    return {
        "total_users": len(users),
        "turnover": sum(p["price"] for p in purchases),
        "total_purchases": len(purchases),
        "top_refs": top_refs,
    }


