def _sanitize(s: str) -> str:
    if s is None:
        return ""
    return str(s).replace("|", "/").replace("\n", " ").replace("\r", " ").strip()


def _clean_text(s: str) -> str:
    return (s or "").replace("|", "/").replace("\n", "\\n").replace("\r", "").strip()


def _unclean_text(s: str) -> str:
    return (s or "").replace("\\n", "\n")


