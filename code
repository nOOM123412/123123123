# ============================================================
async def perform_purchase(user_id, service, plan, period):
    if service not in SERVICE_NAMES:
        return {"ok": False, "error": "Сервис не найден"}

    data = get_plan(service, plan, period)
    if data is None:
        return {"ok": False, "error": "Тариф не найден"}

    title, price = data
    period_name = PERIOD_NAMES.get(period, period)

    u = await db_get_user(user_id)
    if not u:
        return {"ok": False, "error": "Пользователь не найден"}

    balance = float(u.get("balance", 0))
    if balance < price:
        return {
            "ok": False,
            "error": f"Недостаточно средств. Нужно {fmt_money(price)} ₽, у тебя {fmt_money(balance)} ₽",
        }

    codes = await db_take_codes_by_period(period, user_id)

    await db_add_balance(user_id, -price)
    full_title = f"{SERVICE_NAMES[service]} | {title} | {period_name}"
    pid = await db_add_purchase(
        user_id=user_id, service=service,
        product_id=f"{service}_{plan}_{period}",
        title=full_title, price=price, codes=codes,
    )

    u = await db_get_user(user_id) or {}
    return {
        "ok": True,
        "purchase_id": pid,
        "title": full_title,
        "price": price,
        "codes": codes,
        "balance": float(u.get("balance", 0)),
    }


