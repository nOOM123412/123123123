def _read_stock_sync():
    _ensure_text_files()
    result = []
    with open(STOCK_FILE, "r", encoding="utf-8") as f:
        for line in f:
            raw = line.strip()
            if not raw or raw.startswith("#"):
                continue
            parts = [p.strip() for p in raw.split(",")]
            if len(parts) < 2:
                continue
            try:
                nominal = int(parts[0])
                code = parts[1]
                result.append((nominal, code, line))
            except ValueError:
                continue
    return result


def _take_codes_by_period_sync(period, user_id):
    combo = CODES_BY_PERIOD.get(period)
    if not combo:
        return []

    all_rows = _read_stock_sync()
    available = {}
    for nom, code, _line in all_rows:
        available.setdefault(nom, []).append(code)

    for nom, need in combo.items():
        if len(available.get(nom, [])) < need:
            return []

    selected = []
    selected_codes = set()
    for nom, need in combo.items():
        for code in available[nom][:need]:
            selected.append((nom, code))
            selected_codes.add(code)

    with open(STOCK_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()
    new_lines = []
    for line in lines:
        raw = line.strip()
        if not raw or raw.startswith("#"):
            new_lines.append(line); continue
        parts = [p.strip() for p in raw.split(",")]
        if len(parts) < 2:
            new_lines.append(line); continue
        if parts[1] in selected_codes:
            continue
        new_lines.append(line)

    with open(STOCK_FILE, "w", encoding="utf-8") as f:
        f.writelines(new_lines)

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(STOCK_USED_FILE, "a", encoding="utf-8") as f:
        for nom, code in selected:
            f.write(f"{nom},{code},{user_id},{now}\n")

    return [code for _, code in selected]


