async def send_photo_msg(target: Message, text: str, kb=None):
    if PHOTO_FILE is not None:
        try:
            return await target.answer_photo(photo=PHOTO_FILE, caption=text, reply_markup=kb)
        except Exception as e:
            log.warning("photo send failed: %s", e)
