async def wa_promo(request):
    try:
        data = await request.json()
    except Exception:
        return web.json_response({"error": "bad json"}, status=400)

    user_id = data.get("user_id")
    code = (data.get("code") or "").strip().upper()
    if not user_id or not code:
        return web.json_response({"error": "missing params"}, status=400)

    uid = int(user_id)

    if code not in PROMOS:
        return web.json_response({"error": "Такого промокода не существует"}, status=400)
    if await db_promo_is_used(code):
        return web.json_response({"error": "Этот промокод уже использован"}, status=400)

    amount = PROMOS[code]
    if not await db_get_user(uid):
        return web.json_response({"error": "Пользователь не найден"}, status=404)

    await db_add_balance(uid, amount)
    await db_mark_promo_used(code, uid, amount)

    u = await db_get_user(uid) or {}
    return web.json_response({"ok": True, "amount": amount, "user": u})


