async def webapp_runner():
    app = web.Application()
    app.router.add_get("/", wa_index)
    app.router.add_get("/api/user/{user_id}", wa_user)
    app.router.add_get("/api/purchases/{user_id}", wa_purchases)
    app.router.add_get("/api/catalog", wa_catalog)
    app.router.add_get("/api/reviews", wa_reviews)
    app.router.add_get("/api/cities/search", wa_cities_search)
    app.router.add_post("/api/buy", wa_buy)
    app.router.add_post("/api/support", wa_support)
    app.router.add_post("/api/promo", wa_promo)
    app.router.add_post("/api/ref_withdraw", wa_ref_withdraw)
    app.router.add_post("/api/start_topup", wa_start_topup)
    app.router.add_post("/api/set_city", wa_set_city)

    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", WEBAPP_PORT)
    await site.start()
    print(f"🌐 Web App: http://localhost:{WEBAPP_PORT}")
    print(f"🔗 Публичный URL: {WEBAPP_URL}")


async def start_webapp_if_ready():
    if not webapp_enabled():
        print("⚠️  WEBAPP_URL не настроен — мини-апп отключён")
        return
    try:
        await webapp_runner()
    except Exception as e:
        log.exception("webapp runner failed: %s", e)


