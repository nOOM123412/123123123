@dp.callback_query(F.data.startswith("topup_check_"))
async def cb_topup_check(call: CallbackQuery):
    await call.answer()
    try:
        req_id = int(call.data.split("_")[-1])
    except ValueError:
        return

    req = await db_get_topup_by_id(req_id)
    if not req:
        return await call.answer("Заявка не найдена", show_alert=True)
    if req["user_id"] != call.from_user.id:
        return await call.answer("Это не твоя заявка", show_alert=True)
    if req["status"] == "approved":
        return await call.answer("✅ Платёж уже зачислен", show_alert=True)

    system = req.get("system") or "sbp"
    paid_amount = None

    if system == "sbp":
        result = await cactus_get_payment(req["order_id"])
        if result.get("status") != "success":
            return await call.answer(
                "⏳ Платёж ещё не подтверждён. Попробуй через минуту.",
                show_alert=True,
            )
        resp = result.get("response") or {}
        if (resp.get("status") or "").upper() != "ACCEPT":
            return await call.answer(
                "⏳ Платёж ещё не подтверждён. Попробуй через минуту.",
                show_alert=True,
            )
        try:
            paid_amount = float(str(resp.get("amount") or req["amount"]))
        except (ValueError, TypeError):
            paid_amount = float(req["amount"])

    elif system == "crypto":
        try:
            invoices = await crypto.get_invoices(invoice_ids=req["invoice_id"])
        except Exception as e:
            return await call.answer(f"Ошибка: {e}", show_alert=True)

        items = invoices if isinstance(invoices, list) else getattr(invoices, "items", [])
        if not items:
            return await call.answer("Счёт ещё не оплачен.", show_alert=True)
        inv = items[0]
        if inv.status != "paid":
            return await call.answer(
                f"⏳ Статус: {inv.status}. Попробуй ещё раз через минуту.",
                show_alert=True,
            )
        paid_amount = float(req["amount"])

    else:
        return await call.answer("Неизвестная система оплаты", show_alert=True)

    if paid_amount is None:
        return await call.answer("Не удалось определить сумму", show_alert=True)

    uid = call.from_user.id
    await db_set_topup_status(req_id, "approved")
    await db_add_balance(uid, paid_amount)

    user = await db_get_user(uid)
    if user and user.get("referrer_id"):
        bonus = round(paid_amount * REFERRAL_PERCENT / 100, 2)
        await db_add_balance(user["referrer_id"], bonus, to_ref=True)
        try:
            await bot.send_message(
                user["referrer_id"],
                f"💸 Реферальное начисление: <b>+{fmt_money(bonus)} ₽</b> "
                "с пополнения твоего реферала.",
            )
        except Exception:
            pass

    u = await db_get_user(uid) or {}
    kb_after_pay = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(
            text="🚀 Вернуться в магазин",
            web_app=WebAppInfo(url=f"{WEBAPP_URL}/?user_id={uid}")
        )],
    ])
    await show(
        call,
        f"✅ <b>Платёж подтверждён!</b>\n\n"
        f"💰 Зачислено: <b>+{fmt_money(paid_amount)} ₽</b>\n"
        f"🏦 Твой баланс: <b>{fmt_money(u.get('balance', 0))} ₽</b>\n\n"
        "Возвращайся в магазин — там можно купить подписку.",
        kb_after_pay,
    )


