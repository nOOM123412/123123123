def _read_purchases_sync() -> list:
    if not os.path.exists(PURCHASES_FILE):
        return []
    rows = []
    with open(PURCHASES_FILE, "r", encoding="utf-8") as f:
        for line in f:
            raw = line.rstrip("\n")
            if not raw or raw.startswith("#"):
                continue
            parts = raw.split("|")
            if len(parts) < 8:
                continue
            try:
                rows.append({
                    "id": int(parts[0]),
                    "user_id": int(parts[1]),
                    "service": parts[2],
                    "product_id": parts[3],
                    "title": parts[4],
                    "price": float(parts[5] or 0),
                    "codes": parts[6],
                    "created_at": parts[7],
                })
            except (ValueError, IndexError):
                continue
    return rows


async def db_add_purchase(user_id, service, product_id, title, price, codes):
    codes_str = ";".join(codes) if codes else ""

    def _inner():
        rows = _read_purchases_sync()
        new_id = (max((r["id"] for r in rows), default=0)) + 1
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with open(PURCHASES_FILE, "a", encoding="utf-8") as f:
            f.write(
                f"{new_id}|{user_id}|{_sanitize(service)}|{_sanitize(product_id)}|"
                f"{_sanitize(title)}|{price}|{codes_str}|{now}\n"
            )
        return new_id

    async with _purchases_lock:
        new_id = await asyncio.to_thread(_inner)

    async with _users_lock:
        def _bump():
            users = _read_users_sync()
            if user_id in users:
                users[user_id]["purchases_count"] = int(users[user_id]["purchases_count"]) + 1
                _write_users_sync(users)
        await asyncio.to_thread(_bump)

    return new_id


async def db_get_purchases(user_id, limit=15):
    rows = await asyncio.to_thread(_read_purchases_sync)
    rows = [r for r in rows if r["user_id"] == user_id]
    rows.sort(key=lambda r: r["id"], reverse=True)
    return rows[:limit]


async def db_get_purchase(pid, user_id):
    rows = await asyncio.to_thread(_read_purchases_sync)
    for r in rows:
        if r["id"] == pid and r["user_id"] == user_id:
            return r
    return None


