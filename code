                                  disable_web_page_preview=True)


async def show(call: CallbackQuery, text: str, kb=None):
    if PHOTO_FILE is not None:
        try:
            await call.message.edit_caption(caption=text, reply_markup=kb)
            return
        except Exception:
            pass
    try:
        await call.message.delete()
