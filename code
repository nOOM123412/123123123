async def wa_index(request):
    for name in ("Base.html", "base.html", "index.html"):
        p = os.path.join(WEBAPP_DIR, name)
        if os.path.exists(p):
            return web.FileResponse(p)
    files = os.listdir(WEBAPP_DIR) if os.path.isdir(WEBAPP_DIR) else []
    log.error("WebApp HTML не найден. Файлы в webapp/: %s", files)
    return web.Response(
        text=f"HTML не найден в {WEBAPP_DIR}.\nФайлы: {files}\nОжидается: Base.html",
        status=404,
    )


async def wa_user(request):
    try:
        uid = int(request.match_info["user_id"])
    except (ValueError, KeyError):
        return web.json_response({"error": "bad id"}, status=400)
    u = await db_get_user(uid)
    if not u:
        return web.json_response({"error": "not found"}, status=404)
    return web.json_response(u)


async def wa_purchases(request):
    try:
        uid = int(request.match_info["user_id"])
    except (ValueError, KeyError):
        return web.json_response({"error": "bad id"}, status=400)
    items = await db_get_purchases(uid, 50)
    return web.json_response(items)


async def wa_catalog(request):
    result = {}
    for code, name in SERVICES:
        plans = []
        for plan_code, title, prices in PLANS.get(code, []):
            pill_list = []
            for period_code, period_name in PERIODS:
                price = prices.get(period_code)
                if price is None:
                    continue
                pill_list.append({
                    "period": period_name,
                    "period_code": period_code,
                    "price": fmt_money(price),
                })
            plans.append({"code": plan_code, "title": title, "prices": pill_list})
        result[code] = {"name": name, "plans": plans}
    return web.json_response(result)


async def wa_reviews(request):
    try:
        page = int(request.query.get("page", 0))
    except ValueError:
        page = 0
    total = len(REVIEWS)
    per_page = 10
    start = page * per_page
    end = start + per_page
    return web.json_response({
        "total": total,
        "page": page,
        "has_more": end < total,
        "reviews": REVIEWS[start:end],
    })


async def wa_cities_search(request):
    q = (request.query.get("q") or "").strip().lower()
    if not q:
        return web.json_response(CITIES[:30])
    result = [c for c in CITIES if q in c.lower()][:50]
    return web.json_response(result)


async def wa_set_city(request):
    try:
        data = await request.json()
    except Exception:
        return web.json_response({"error": "bad json"}, status=400)

    user_id = data.get("user_id")
    city = (data.get("city") or "").strip()
    if not user_id or not city:
        return web.json_response({"error": "missing params"}, status=400)

    uid = int(user_id)
    if not await db_get_user(uid):
        return web.json_response({"error": "user not found"}, status=404)

    if len(city) > 60:
        city = city[:60]

    await db_set_city(uid, city)
    u = await db_get_user(uid) or {}
    return web.json_response({"ok": True, "user": u})


async def wa_buy(request):
    try:
        data = await request.json()
    except Exception:
        return web.json_response({"error": "bad json"}, status=400)

    user_id = data.get("user_id")
    service = data.get("service")
    plan    = data.get("plan")
    period  = data.get("period")

    if not all([user_id, service, plan, period]):
        return web.json_response({"error": "missing params"}, status=400)

    res = await perform_purchase(int(user_id), service, plan, period)
    if not res.get("ok"):
        return web.json_response({"error": res.get("error")}, status=400)

    u = await db_get_user(int(user_id)) or {}
    res["user"] = u
    return web.json_response(res)


