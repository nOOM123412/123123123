def _rewrite_topup_status_sync(req_id, status):
    rows = _read_topups_sync()
    changed = False
    for r in rows:
        if r["id"] == req_id:
            r["status"] = status
            changed = True
    if not changed:
        return
    tmp = TOPUPS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# id|user_id|system|order_id|invoice_id|amount|"
                "cact_id|pay_url|status|created_at\n")
        for r in rows:
            f.write(
                f"{r['id']}|{r['user_id']}|{r['system']}|{_sanitize(r['order_id'])}|"
                f"{r['invoice_id'] or ''}|{r['amount']}|{r['cact_id'] or ''}|"
                f"{_sanitize(r['pay_url'])}|{r['status']}|{r['created_at']}\n"
            )
    os.replace(tmp, TOPUPS_FILE)


