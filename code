def _read_users_sync() -> dict:
    if not os.path.exists(USERS_FILE):
        return {}
    users = {}
    with open(USERS_FILE, "r", encoding="utf-8") as f:
        for line in f:
            raw = line.rstrip("\n")
            if not raw or raw.startswith("#"):
                continue
            parts = raw.split("|")
            if len(parts) < 8:
                continue
            try:
                uid = int(parts[0])
            except ValueError:
                continue
            users[uid] = {
                "user_id": uid,
                "username": parts[1],
                "full_name": parts[2],
                "balance": float(parts[3] or 0),
                "ref_balance": float(parts[4] or 0),
                "purchases_count": int(parts[5] or 0),
                "referrer_id": int(parts[6]) if parts[6] else None,
                "created_at": parts[7],
                "city": parts[8] if len(parts) > 8 else "",
            }
    return users


def _write_users_sync(users: dict):
    tmp = USERS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# user_id|username|full_name|balance|ref_balance|"
                "purchases_count|referrer_id|created_at|city\n")
        for u in users.values():
            ref = u["referrer_id"] if u["referrer_id"] else ""
            f.write(
                f"{u['user_id']}|{_sanitize(u['username'])}|{_sanitize(u['full_name'])}|"
                f"{u['balance']}|{u['ref_balance']}|{u['purchases_count']}|"
                f"{ref}|{u['created_at']}|{_sanitize(u.get('city', ''))}\n"
            )
    os.replace(tmp, USERS_FILE)


async def db_get_user(user_id):
    users = await asyncio.to_thread(_read_users_sync)
    return users.get(user_id)


async def db_create_user(user_id, username, full_name, referrer_id=None):
    async with _users_lock:
        def _inner():
            users = _read_users_sync()
            if user_id in users:
                return
            users[user_id] = {
                "user_id": user_id,
                "username": _normalize_username(username),
                "full_name": full_name or "",
                "balance": 0.0,
                "ref_balance": 0.0,
                "purchases_count": 0,
                "referrer_id": referrer_id,
                "created_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "city": "",
            }
            _write_users_sync(users)
        await asyncio.to_thread(_inner)


