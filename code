async def cactus_create_payment(amount: float, order_id: str, description: str) -> dict:
    payload = {
        "token": CACTUS_TOKEN,
        "amount": amount,
        "currency": "RUB",
        "order_id": order_id,
        "description": description,
        "redirect_url": f"https://t.me/{BOT_USERNAME}",
    }
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                f"{CACTUS_API}?method=create",
                json=payload,
                headers={"Content-Type": "application/json"},
                timeout=aiohttp.ClientTimeout(total=20),
            ) as resp:
                return await resp.json(content_type=None)
    except Exception as e:
        log.exception("cactus_create_payment error")
        return {"status": "error", "response": str(e)}


async def cactus_get_payment(order_id: str) -> dict:
    payload = {"token": CACTUS_TOKEN, "order_id": order_id}
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                f"{CACTUS_API}?method=get",
                json=payload,
                headers={"Content-Type": "application/json"},
                timeout=aiohttp.ClientTimeout(total=20),
            ) as resp:
                return await resp.json(content_type=None)
    except Exception as e:
        log.exception("cactus_get_payment error")
        return {"status": "error", "response": str(e)}


